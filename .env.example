# Copy to .env and adjust. Every value has a safe local default; nothing here is a secret.
MEMORYFORGE_DB_PATH=./data/memoryforge.db
MEMORYFORGE_QUEUE_BACKEND=memory          # memory | kafka
MEMORYFORGE_KAFKA_BOOTSTRAP=localhost:19092
MEMORYFORGE_KAFKA_TOPIC=conversation.events
MEMORYFORGE_KAFKA_GROUP=memoryforge
MEMORYFORGE_LLM_BACKEND=stub              # stub | ollama
MEMORYFORGE_OLLAMA_URL=http://localhost:11434
MEMORYFORGE_OLLAMA_MODEL=llama3.2
MEMORYFORGE_PROMPT_VERSION=v2
MEMORYFORGE_EMBEDDER=hash                 # hash | fastembed
MEMORYFORGE_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
MEMORYFORGE_VECTOR_BACKEND=auto           # auto | faiss | numpy
MEMORYFORGE_MIN_CONFIDENCE=0.5
MEMORYFORGE_RECENCY_HALF_LIFE_DAYS=30
MEMORYFORGE_RUN_WORKER=true
MEMORYFORGE_LOG_FORMAT=console            # console | json
MEMORYFORGE_LOG_LEVEL=INFO
MEMORYFORGE_OTEL_EXPORTER=none            # none | console | otlp
# Leave empty for open local admin endpoints; set to protect /admin/*, /failures and DELETE.
MEMORYFORGE_ADMIN_TOKEN=
